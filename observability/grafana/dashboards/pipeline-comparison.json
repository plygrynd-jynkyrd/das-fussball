          },
          "expr": "sum by (le) (increase(request_duration_seconds_bucket{instance=~\"app-midfielder.*\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
