{
  "uid": "pipeline",
  "title": "Pipeline Comparison",
  "description": "Where does the time go between defender, midfielder and attacker? Note the defender's duration is end-to-end: it includes both downstream calls.",
  "tags": [
    "das-fussball"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "The **defender** duration is end-to-end (its send waits for midfielder, which waits for attacker). Subtract a downstream service's latency from its caller's to get the time spent in that service itself."
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Average duration per service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(request_duration_seconds_sum[$__rate_interval])) / sum by (instance) (rate(request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "p95 duration per service",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Average duration by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, route) (rate(request_duration_seconds_sum[$__rate_interval])) / sum by (instance, route) (rate(request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{instance}} {{route}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Latency distribution (heatmaps)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 15,
      "type": "heatmap",
      "title": "app-defender",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(request_duration_seconds_bucket{instance=~\"app-defender.*\"}[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
