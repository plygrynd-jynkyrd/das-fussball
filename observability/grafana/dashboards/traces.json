{
  "uid": "traces",
  "title": "Traces",
  "description": "Trace search with TraceQL. Click a row to open the defender -> midfielder -> attacker waterfall.",
  "tags": [
    "das-fussball"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "id": 20,
      "type": "table",
      "title": "Slowest traces (> 1s)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"app-defender\" && duration > 1s }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Traces with errors",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"app-defender\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Span rate by service (TraceQL metrics)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ } | rate() by (resource.service.name)"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "p95 span duration by service (TraceQL metrics)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ kind = server } | quantile_over_time(duration, .95) by (resource.service.name)"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
